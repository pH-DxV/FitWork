# Copie para ".env" e ajuste os valores. O arquivo .env NUNCA deve ser versionado.
# Os valores abaixo são exemplos para desenvolvimento local.

# ---------- Keycloak ----------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha
# Segredo do client confidencial "fitwork-backend" (usado pelo Keycloak e pelo Quarkus)
KEYCLOAK_CLIENT_SECRET=troque-este-segredo-longo-e-aleatorio

# ---------- Back-end Quarkus ----------
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=fitwork
KEYCLOAK_CLIENT_ID=fitwork-backend
# true em produção (HTTPS); false apenas em desenvolvimento local via http
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:4200

# ---------- Object Storage (RustFS / S3) ----------
S3_ACCESS_KEY=fitwork
S3_SECRET_KEY=fitwork123
